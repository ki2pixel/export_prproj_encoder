# Exemple de configuration via .env
# Dupliquez ce fichier en ".env" et adaptez les valeurs si nécessaire.

# Chemins principaux
# /mnt/cache correspond au disque F: de la version Windows (dossier scanné, jamais écrit par l'app)
BASE_SCAN_FOLDER=/mnt/cache
FOLDER_KEYWORD=Camille
PROJECTS_SUBFOLDER=projets
# Extensions des projets soumis (séparées par des virgules)
INPUT_EXTENSIONS=.prproj

# Watch folders locaux à l'application (remplacent les watch folders d'Adobe Media Encoder)
WATCH_FOLDER_INPUT=/home/kidpixel/export_prproj_encoder/WATCH_IN
WATCH_FOLDER_OUTPUT=/home/kidpixel/export_prproj_encoder/WATCH_OUT
SOURCE_ARCHIVE_DIRNAME=Source
STAGING_DIRNAME=.staging
QUARANTINE_DIRNAME=quarantine

# Logs, base de données, journaux d'encodage
LOGS_DIRECTORY=/home/kidpixel/export_prproj_encoder/logs_watchfolder
# SUBMISSION_LOG_FILE est le registre structuré (une ligne CSV par soumission, jamais tronqué)
SUBMISSION_LOG_FILE=
# SUBMISSION_TEXT_LOG_FILE est le journal texte lisible (archivé à chaque soumission)
SUBMISSION_TEXT_LOG_FILE=
MONITOR_LOG_FILE=
ENCODER_LOG_FILE=
EXPORT_LOG_DIRECTORY=

# Sortie
OUTPUT_EXTENSION=.mp4
# Placeholder disponible : {project_file_stem} (nom du fichier .prproj, préfixe numérique,
# suffixes « copy N » et « _assist » retirés ; les suffixes de version « _2 », « _3 »… sont conservés)
OUTPUT_FILENAME_FORMAT={project_file_stem}

# prproj2ffmpeg (export des projets Premiere .prproj en MP4 H.264 via ffmpeg)
# Script vendorisé dans tools/prproj-unpacker/ (voir PROVENANCE.md) ; chemin surchargeable
PRPROJ2FFMPEG_SCRIPT=/home/kidpixel/export_prproj_encoder/tools/prproj-unpacker/prproj2ffmpeg.py
# auto = h264_nvenc si disponible (repli libx264 automatique) ; ou encodage forcé (h264_nvenc, libx264…)
PRPROJ2FFMPEG_ENCODER=auto
# Débit vidéo CBR (format ffmpeg : 10M, 8000k…)
PRPROJ2FFMPEG_BITRATE=10M
# Bases supplémentaires pour résoudre les chemins médias du XML (séparées par « : »).
# Les bases automatiques sont : racine du projet d'origine, son parent, BASE_SCAN_FOLDER,
# puis dossier du projet copié, ses parents et le répertoire courant (ajoutés par le script).
PRPROJ2FFMPEG_EXTRA_BASES=
# Plafond du cache disque des intermédiaires alpha/bbox, en Mo (défaut 2048 ; 0 = illimité).
# Purge LRU au démarrage de chaque export : les entrées les moins récemment utilisées partent d'abord.
PRPROJ2FFMPEG_CACHE_MAX_MB=2048
# Queue inutilisée (s) tolérée avant de convertir l'intermédiaire alpha en pleine durée.
# Défaut 15 ; augmenter (ex. 60) pour un lot de séquences partageant le même média.
# Les sidecars .qtrle.json permettent aussi de réutiliser une plage plus longue déjà convertie.
PRPROJ2FFMPEG_ALPHA_FULL_TAIL_MAX=15

# Encodeur
ENCODER_POLL_INTERVAL=2
ENCODER_PROGRESS_INTERVAL=5
ENCODER_ABORT_GRACE_SECONDS=5

# Surveillance / déplacement
STABLE_FILE_CHECKS=2
STABLE_FILE_INTERVAL=5
MOVE_RETRY_COUNT=12
MOVE_RETRY_DELAY=10
# Rescan périodique du dossier de sortie (filet de sécurité inotify) - 0 = désactivé
RESCAN_INTERVAL_SECONDS=60
# Délai pendant lequel un fichier de sortie récent est protégé de l'option « Nettoyer les sorties »
CLEAN_OUTPUT_GUARD_SECONDS=60

# Règles de déplacement
# ALLOW_OVERWRITE=False
# ENABLE_FALLBACK_MOVE=False
# ENABLE_HEURISTIC_MATCHING=True

# API / Sécurité (Authentification par session)
# API_USER=admin
# API_PASSWORD=UnMotDePasseTresFort
# SECRET_KEY=UneClefSecreteTresLongueEtTresComplexe
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=False
#
# Si API_PASSWORD ou SECRET_KEY est vide, une valeur temporaire est générée au démarrage
# et affichée en console : configurez ces valeurs pour un mot de passe persistant.
